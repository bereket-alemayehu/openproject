<style type="text/css">
  <%
    # Point all variants to the bundled image Moh_Logo.png
    moh_logo = asset_path("Moh_Logo.png")
    moh_blue=asset_path("MOH.png")
    logo_url = logo_icon_url = logo_icon_white_url = high_contrast_logo_url = high_contrast_bim_logo_url = moh_logo
    logo_url2 = logo_icon_url = logo_icon_white_url = high_contrast_logo_url = high_contrast_bim_logo_url = moh_blue
  %>

  /* Shared look: white background (square) */
 

  /* Base sizing & positioning */
  .op-logo--link,
  .op-logo--icon,
  .op-logo--icon_white,
  .op-logo--link_high_contrast {
    width: 100px;
    height: 45px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  .op-logo--link {
    background-image: url(<%= logo_url %>);
    margin-top: 5px;
  }

  .op-logo--icon,
  .op-logo--icon_white,
  .op-logo--link_high_contrast {
    background-image: url(<%= logo_icon_url %>);
    margin-top: -20px;
  }

 

  .op-app-header--modules-menu-header .op-logo--icon {
    margin-top: 4px;
    height: 56px;
    width: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    background-image: url(<%= logo_url2 %>);

  }
  
</style>